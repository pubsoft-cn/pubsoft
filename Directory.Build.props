<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <!-- Internal-validation releases carry a prerelease suffix so they never
         collide with the eventual stable public version. Bump the counter per
         validation drop; drop the suffix entirely for the public stable release. -->
    <!-- Two streams: external (alpha.*, nuget.org) and dev (internal feed).
         PubSoftVersion is the canonical release version - central package pins
         and in-repo package references resolve it. Dev builds stamp artifacts
         dev.yyyymmdd.<stamp>: -p:PubSoftDevStamp=... supplies a single stamp
         for the whole wave (pack scripts use seconds-of-day); without it each
         project falls back to its own tick stamp, so always pass the shared
         stamp when packing the full solution. -->
    <PubSoftVersion>0.1.0-alpha.16</PubSoftVersion>
    <PubSoftPackageVersion Condition="'$(PubSoftStream)' == 'dev'">0.1.0-dev.$([System.DateTime]::UtcNow.ToString(yyyyMMdd)).$(PubSoftDevStamp)</PubSoftPackageVersion>
    <PubSoftDevStamp Condition="'$(PubSoftDevStamp)' == ''">$([System.DateTime]::UtcNow.TimeOfDay.Ticks)</PubSoftDevStamp>
    <PubSoftPackageVersion Condition="'$(PubSoftStream)' != 'dev'">$(PubSoftVersion)</PubSoftPackageVersion>
    <Version>$(PubSoftPackageVersion)</Version>
    <RepositoryType>git</RepositoryType>
    <RepositoryUrl>https://github.com/pubsoft-cn/pubsoft</RepositoryUrl>
    <Authors>PubSoft Contributors</Authors>
    <Company>PubSoft</Company>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <!-- SDK built-in SourceLink (no package, no advisory): F12-into-source for consumers. -->
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
      <!-- NuGet audit hard gate: high/critical advisories fail restore. -->
    <NuGetAudit>true</NuGetAudit>
    <NuGetAuditMode>all</NuGetAuditMode>
    <WarningsAsErrors>$(WarningsAsErrors);NU1903;NU1904</WarningsAsErrors>
  </PropertyGroup>
</Project>
