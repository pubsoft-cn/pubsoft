<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <PublishAot>true</PublishAot>
    <RuntimeIdentifier>linux-x64</RuntimeIdentifier>
    <InvariantGlobalization>true</InvariantGlobalization>
    <JsonSerializerIsReflectionEnabledByDefault>false</JsonSerializerIsReflectionEnabledByDefault>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="PubSoft.Auditing" Version="0.1.0-*" />
    <PackageReference Include="PubSoft.Authentication.OAuthProviders" Version="0.1.0-*" />
    <PackageReference Include="PubSoft.Caching" Version="0.1.0-*" />
    <PackageReference Include="PubSoft.Contracts" Version="0.1.0-*" />
    <PackageReference Include="PubSoft.Core" Version="0.1.0-*" />
    <PackageReference Include="PubSoft.Cryptography" Version="0.1.0-*" />
    <PackageReference Include="PubSoft.Domain" Version="0.1.0-*" />
    <PackageReference Include="PubSoft.Events" Version="0.1.0-*" />
    <PackageReference Include="PubSoft.Logging" Version="0.1.0-*" />
    <PackageReference Include="PubSoft.Mapping" Version="0.1.0-*" />
    <PackageReference Include="PubSoft.Messaging" Version="0.1.0-*" />
    <PackageReference Include="PubSoft.MultiTenancy" Version="0.1.0-*" />
    <PackageReference Include="PubSoft.Notifications" Version="0.1.0-*" />
    <PackageReference Include="PubSoft.Resilience" Version="0.1.0-*" />
    <PackageReference Include="PubSoft.Scheduling" Version="0.1.0-*" />
    <PackageReference Include="PubSoft.Testing" Version="0.1.0-*" />
    <PackageReference Include="PubSoft.Tokens" Version="0.1.0-*" />
  </ItemGroup>
</Project>
