<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <PublishAot>true</PublishAot>
    <RuntimeIdentifier>linux-x64</RuntimeIdentifier>
    <InvariantGlobalization>true</InvariantGlobalization>
    <JsonSerializerIsReflectionEnabledByDefault>false</JsonSerializerIsReflectionEnabledByDefault>
  </PropertyGroup>

  <!-- Build-time invariant: the set of PubSoft packages marked IsAotCompatible must
       equal the set referenced here — otherwise a new leaf package silently drops
       out of AOT coverage. TrimmerRootAssembly roots every marked assembly so
       publish analyzes them whole, not just reachable call sites. -->
  <Target Name="AssertAotCoverage" BeforeTargets="Build">
    <ItemGroup>
      <_SrcProjects Include="$(MSBuildThisFileDirectory)..\..\src\*\*\*.csproj" />
    </ItemGroup>
    <!-- Nested evaluation: each src project reports its own PackageId when marked —
         authoritative set, independent of file naming. The smoke references only
         PubSoft packages, so a plain set difference is exact. -->
    <MSBuild Projects="%(_SrcProjects.Identity)" Targets="GetAotMarkedPackageId" BuildInParallel="false">
      <Output TaskParameter="TargetOutputs" ItemName="_AotMarked" />
    </MSBuild>
    <ItemGroup>
      <!-- PublishAot injects toolchain refs (ILCompiler/ILLink) — compare only PubSoft.* -->
      <_PubSoftRefs Include="@(PackageReference)"
                    Condition="$([System.String]::Copy('%(Identity)').StartsWith('PubSoft.'))" />
      <_MissingAot Include="@(_AotMarked)" Exclude="@(_PubSoftRefs)" />
      <_StaleAot Include="@(_PubSoftRefs)" Exclude="@(_AotMarked)" />
    </ItemGroup>
    <Error Condition="'@(_MissingAot)' != ''"
           Text="IsAotCompatible package(s) missing from the AOT smoke project: @(_MissingAot)" />
    <Error Condition="'@(_StaleAot)' != ''"
           Text="Smoke project references package(s) no longer marked IsAotCompatible: @(_StaleAot)" />
    <ItemGroup>
      <TrimmerRootAssembly Include="@(_AotMarked)" />
    </ItemGroup>
  </Target>

  <ItemGroup>
    <PackageReference Include="PubSoft.Auditing" VersionOverride="0.1.0-*" />
    <PackageReference Include="PubSoft.Authentication" VersionOverride="0.1.0-*" />
    <PackageReference Include="PubSoft.Authentication.Jwt" VersionOverride="0.1.0-*" />
    <PackageReference Include="PubSoft.Authentication.OAuthProviders" VersionOverride="0.1.0-*" />
    <PackageReference Include="PubSoft.Authorization" VersionOverride="0.1.0-*" />
    <PackageReference Include="PubSoft.Caching" VersionOverride="0.1.0-*" />
    <PackageReference Include="PubSoft.Contracts" VersionOverride="0.1.0-*" />
    <PackageReference Include="PubSoft.Core" VersionOverride="0.1.0-*" />
    <PackageReference Include="PubSoft.Cryptography" VersionOverride="0.1.0-*" />
    <PackageReference Include="PubSoft.Domain" VersionOverride="0.1.0-*" />
    <PackageReference Include="PubSoft.Events" VersionOverride="0.1.0-*" />
    <PackageReference Include="PubSoft.Identity" VersionOverride="0.1.0-*" />
    <PackageReference Include="PubSoft.Logging" VersionOverride="0.1.0-*" />
    <PackageReference Include="PubSoft.Mapping" VersionOverride="0.1.0-*" />
    <PackageReference Include="PubSoft.Messaging" VersionOverride="0.1.0-*" />
    <PackageReference Include="PubSoft.Monitoring" VersionOverride="0.1.0-*" />
    <PackageReference Include="PubSoft.Monitoring.Scheduling" VersionOverride="0.1.0-*" />
    <PackageReference Include="PubSoft.MultiTenancy" VersionOverride="0.1.0-*" />
    <PackageReference Include="PubSoft.Notifications" VersionOverride="0.1.0-*" />
    <PackageReference Include="PubSoft.Outbound" VersionOverride="0.1.0-*" />
    <PackageReference Include="PubSoft.Resilience" VersionOverride="0.1.0-*" />
    <PackageReference Include="PubSoft.Resilience.Http" VersionOverride="0.1.0-*" />
    <PackageReference Include="PubSoft.Scheduling" VersionOverride="0.1.0-*" />
    <PackageReference Include="PubSoft.Scheduling.Http" VersionOverride="0.1.0-*" />
    <PackageReference Include="PubSoft.Security" VersionOverride="0.1.0-*" />
    <PackageReference Include="PubSoft.Testing" VersionOverride="0.1.0-*" />
    <PackageReference Include="PubSoft.Tokens" VersionOverride="0.1.0-*" />
  </ItemGroup>
</Project>
