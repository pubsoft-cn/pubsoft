<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <PubSoftDocDiscipline>full</PubSoftDocDiscipline>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>PubSoft.Scheduling</RootNamespace>
    <PackageId>PubSoft.Scheduling</PackageId>
    <IsAotCompatible>true</IsAotCompatible>
    <Version>$(PubSoftPackageVersion)</Version>
    <Description>Provider-neutral scheduled job engine with bounded concurrency and extensible executors.</Description>
    <PackageTags>scheduling;jobs;hosted-service;bitmask</PackageTags>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="PubSoft.Core.Tests" />
    <InternalsVisibleTo Include="PubSoft.Platform.Tests" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Options" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../../core/PubSoft.Core/PubSoft.Core.csproj" />
    <ProjectReference Include="../PubSoft.Caching/PubSoft.Caching.csproj" />
  </ItemGroup>

</Project>