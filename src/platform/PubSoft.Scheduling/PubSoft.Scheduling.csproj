<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>PubSoft.Scheduling</RootNamespace>
    <PackageId>PubSoft.Scheduling</PackageId>
    <IsAotCompatible>true</IsAotCompatible>
    <Version>$(PubSoftVersion)</Version>
    <Description>Provider-neutral scheduled job engine with bounded concurrency and extensible executors.</Description>
    <PackageTags>scheduling;jobs;hosted-service;bitmask</PackageTags>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="PubSoft.Core.Tests" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.13" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" Version="10.0.13" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.13" />
    <PackageReference Include="Microsoft.Extensions.Options" Version="10.0.13" />
  </ItemGroup>
</Project>