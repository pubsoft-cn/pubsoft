<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <PubSoftDocDiscipline>full</PubSoftDocDiscipline>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>PubSoft.Monitoring</RootNamespace>
    <PackageId>PubSoft.Monitoring</PackageId>
    <IsAotCompatible>true</IsAotCompatible>
    <Version>$(PubSoftVersion)</Version>
    <Description>Provider-neutral monitoring contracts and bounded HTTP probe health checks.</Description>
    <PackageTags>monitoring;health-check;probe</PackageTags>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Http" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Options" />
  </ItemGroup>
</Project>