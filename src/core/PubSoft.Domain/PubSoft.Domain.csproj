<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <PubSoftDocDiscipline>full</PubSoftDocDiscipline>
    <PackageId>PubSoft.Domain</PackageId>
    <IsAotCompatible>true</IsAotCompatible>
    <Description>Framework-independent domain building blocks for PubSoft libraries.</Description>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../PubSoft.Core/PubSoft.Core.csproj" />
  </ItemGroup>

</Project>
