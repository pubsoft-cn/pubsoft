<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <PubSoftDocDiscipline>full</PubSoftDocDiscipline>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>PubSoft.Mapping</RootNamespace>
    <PackageId>PubSoft.Mapping</PackageId>
    <IsAotCompatible>true</IsAotCompatible>
    <Version>$(PubSoftVersion)</Version>
    <Description>Lightweight expression-compiled object mapping with no external dependencies.</Description>
    <PackageTags>mapping;object-mapper;expression-tree</PackageTags>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../PubSoft.Core/PubSoft.Core.csproj" />
  </ItemGroup>

</Project>