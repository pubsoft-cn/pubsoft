<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <PubSoftDocDiscipline>full</PubSoftDocDiscipline>
    <PackageId>PubSoft.Core</PackageId>
    <IsAotCompatible>true</IsAotCompatible>
    <Description>Dependency-free core primitives for PubSoft libraries.</Description>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>
</Project>
