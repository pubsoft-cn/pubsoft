<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <PubSoftDocDiscipline>full</PubSoftDocDiscipline>
    <PackageId>PubSoft.DependencyInjection</PackageId>
    <Description>Convention-based service registration markers and assembly scanning for PubSoft libraries.</Description>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <ProjectReference Include="../PubSoft.Core/PubSoft.Core.csproj" />
  </ItemGroup>
</Project>
