<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <PubSoftCoverageEmitSkip>true</PubSoftCoverageEmitSkip> <!-- build-time analyzer — no runtime surface to contract-test -->
    <!-- Build-time guardrails only — analyzer assemblies are never shipped. -->
    <TargetFramework>netstandard2.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <NoWarn>$(NoWarn);RS2008</NoWarn>
    <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
    <Description>Repo-internal Roslyn analyzers enforcing PubSoft repository conventions.</Description>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" PrivateAssets="all" />
  </ItemGroup>
</Project>
